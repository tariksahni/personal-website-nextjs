NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only (Netlify Functions). Never prefix with NEXT_PUBLIC_.
# AI provider for the wardrobe functions: set ONE of these keys.
# If OPENAI_API_KEY is set it is used; otherwise ANTHROPIC_API_KEY.
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: OpenAI model (must be vision-capable). Defaults to gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini
# Optional: force a provider when both keys are set (openai | anthropic).
# AI_PROVIDER=openai
# Only this Supabase account may use the wardrobe functions
WARDROBE_OWNER_EMAIL=owner@example.com
# Optional: virtual try-on (OpenAI Responses API, background mode + image_generation tool).
# OPENAI_TRYON_MODEL=gpt-4.1-mini
# Image model used by the tool. Defaults to gpt-image-2.
# OPENAI_IMAGE_MODEL=gpt-image-2
# Optional: try-on quality (low | medium | high). Defaults to medium.
# OPENAI_IMAGE_QUALITY=medium
# Optional: outfit suggestions + clothing tags (async jobs: wardrobe-ai-start / wardrobe-ai-status).
# OPENAI_STYLIST_MODEL=gpt-6-astra
# OPENAI_STYLIST_EFFORT=medium   # none|minimal|low|medium|high|xhigh|max (sent to reasoning models only)
# OPENAI_STYLIST_IMAGE_DETAIL=    # low|high|auto|original; default high for <=40 closet items, low above
